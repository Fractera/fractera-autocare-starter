# ==============================================================================
#  autozabota — .env.example
#  Полный справочник переменных окружения проекта.
# ==============================================================================
#
#  ЭТОТ ФАЙЛ БЕЗОПАСЕН ДЛЯ GITHUB. В нём нет ни одного живого значения — только
#  имена, форма значения и объяснение, где это значение берут. Живые ключи лежат
#  в `.env.local`, который перехвачен `.gitignore` и в репозиторий не попадает.
#
#  КАК ПОЛЬЗОВАТЬСЯ
#    cp .env.example .env.local     # затем заполнить значения
#  Либо — и это основной путь для уже развёрнутого сервера — скачать готовый
#  `.env.local` из панели Fractera: Админка → «Переменные окружения» → выгрузка.
#  Панель отдаёт файл, где адреса и секреты слота уже подставлены.
#
# ------------------------------------------------------------------------------
#  ТРИ ИСТОЧНИКА ЗНАЧЕНИЙ — И ЭТО НЕ ВКУСОВЩИНА, А ТЕХНИКА
# ------------------------------------------------------------------------------
#
#  ① `NEXT_PUBLIC_*` — ЗАПЕКАЮТСЯ В СБОРКУ (build-time).
#     Значение попадает в JavaScript, который уезжает в браузер. Следствия:
#       • менять их без пересборки бессмысленно — старое значение остаётся в бандле;
#       • секрет в такую переменную класть НЕЛЬЗЯ: он станет виден любому, кто
#         откроет исходники страницы.
#
#  ② Остальные переменные — РАНТАЙМ-СЕРВЕРНЫЕ.
#     `process.env` читается один раз при старте процесса. Изменил — перезапусти
#     приложение (`pm2 reload`), иначе живёт старое значение.
#
#  ③ КЛЮЧИ ИНТЕГРАЦИЙ — вводятся АДМИНИСТРАТОРОМ НА ЭКРАНЕ, а не сюда.
#     Пять ключей (OPENAI_API_KEY, YCLIENTS_PARTNER_TOKEN, YCLIENTS_USER_TOKEN,
#     CHATPUSH_TOKEN, CHATPUSH_HOOK_SECRET) хранятся в
#     `storage/integration-keys.json`, который читается СВЕЖИМ на каждый запрос:
#     сохранение действует сразу, без перезапуска. Порядок источников — ФАЙЛ
#     СИЛЬНЕЕ ОКРУЖЕНИЯ (`lib/company/keys.ts` → `integrationKey()`). Переменные
#     ниже оставлены как ЗАПАСНОЙ путь: уже настроенный сервер продолжает
#     работать, ничего не трогая. Каталог `storage/` в `.gitignore` и не
#     участвует в доставке — ключи не уедут ни в репозиторий, ни на чужую машину.
#
# ==============================================================================



# ══════════════════════════════════════════════════════════════════════════════
#  1. СЛОЙ ДАННЫХ (data service) — БЕЗ ЭТОГО БЛОКА НЕ РАБОТАЕТ НИЧЕГО
# ══════════════════════════════════════════════════════════════════════════════
#
#  Приложение само не держит базу. Строки, файлы и векторная память живут в
#  отдельной службе Fractera (порт 3300 на сервере). Локальная разработка ходит
#  в ТУ ЖЕ службу по сети: на машину разработчика ничего не копируется, поэтому
#  двух расходящихся копий данных не существует.
#  Читается: lib/fractera/data-service.ts, lib/db/index.ts, lib/media/by-name.ts,
#            app/api/media/**, scripts/seed-media*.mjs

# Адрес слоя данных.
#   • На сервере, где приложение стоит рядом со службой — петля: http://localhost:3300
#   • На машине разработчика — публичный адрес слоя данных вашего слота,
#     вида https://data.<поддомен>.fractera.ai
#   ГДЕ ВЗЯТЬ: Админка → «Переменные окружения» → выгрузка окружения. Там адрес
#   уже подставлен под ваш слот.
#   ВНИМАНИЕ: ЗАДАВАТЬ РОВНО ОДИН РАЗ. Две строки `REMOTE_DATA_URL=` в одном
#   файле — классическая ловушка: побеждает ПОСЛЕДНЯЯ, и приложение молча уходит
#   на localhost вместо боевой базы.
#   БЕЗ НЕЁ: подставляется http://localhost:3300 — на машине разработчика это
#   означает «данных нет» без единой ошибки в логе.
REMOTE_DATA_URL=https://data.example.fractera.ai

# Секрет доступа к слою данных. ОСНОВНОЕ ИМЯ.
#   ГДЕ ВЗЯТЬ: на сервере его пишет установщик Fractera в
#   /opt/fractera/services/data/.env — там же его и смотреть.
#   Для разработчика — та же выгрузка из панели.
#   РОЛЬ: единственное доказательство приложения перед слоем данных. Каждый
#   запрос к данным идёт с ним; без него `dataFetch()` бросает ошибку словами,
#   а не молча возвращает пустоту.
#   ЭТО НАСТОЯЩИЙ СЕКРЕТ. В git не попадает, в NEXT_PUBLIC_* не превращается.
DATA_SECRET=

# УСТАРЕВШЕЕ ИМЯ ТОГО ЖЕ СЕКРЕТА — НЕ ЗАПОЛНЯТЬ.
#   Панель раньше выдавала файлы с именем DATA_API_KEY, и старые слоты ещё живут
#   с ним; ради них код спрашивает DATA_API_KEY, затем DATA_SECRET
#   (lib/fractera/data-service.ts:19).
#   НОВАЯ УСТАНОВКА ЗАПОЛНЯЕТ ТОЛЬКО `DATA_SECRET` — строка ниже оставлена
#   закомментированной намеренно.
#   Два имени одного секрета уже стоили одной аварии: `DATA_API_KEY` в коде при
#   `DATA_SECRET` в окружении дал пустой ключ, и приложение молча писало в
#   локальный SQLite мимо слоя данных (разбор — в шапке lib/db/remote-client.ts).
#   Заданные обе с РАЗНЫМИ значениями — победит DATA_API_KEY: отсюда растут
#   диагностики «ключ вроде правильный, а 401».
# DATA_API_KEY=

# Путь к локальной базе SQLite — ЗАПАСНАЯ дорога, когда слой данных недоступен.
#   Читается: lib/db/index.ts:739. По умолчанию ./data/app.db.
#   Задавать нужно только если файл базы обязан лежать вне проекта (например,
#   на отдельном диске сервера).
# APP_DB_PATH=./data/app.db



# ══════════════════════════════════════════════════════════════════════════════
#  2. АВТОРИЗАЦИЯ И ОБОЛОЧКА
# ══════════════════════════════════════════════════════════════════════════════
#
#  Авторизация вынесена в ОТДЕЛЬНУЮ службу платформы (порт 3001). Приложение не
#  проверяет пароли — оно спрашивает у службы, кто пришёл.
#  Читается: lib/auth/get-session.ts, require-role.ts, require-admin.ts

# Внутренний адрес службы авторизации (сервер-серверный вызов `/api/session`).
#   На боевой машине — петля: http://localhost:3001
#   ГДЕ ВЗЯТЬ: адрес фиксирован установщиком Fractera; в выгрузке панели он есть.
#   БЕЗ НЕЁ: код падает назад на NEXT_PUBLIC_AUTH_URL, затем на http://localhost:3001.
AUTH_SERVICE_URL=http://localhost:3001

# ПУБЛИЧНЫЙ адрес страницы входа — тот, куда браузер отправляет человека.
#   Форма: https://auth.<поддомен>.<домен>
#   (локально — http://auth.partner.fractera.local:3001)
#   ГДЕ ВЗЯТЬ: панель Fractera, раздел доменов слота; в выгрузке окружения готов.
#   NEXT_PUBLIC → запекается в сборку, смена требует пересборки.
NEXT_PUBLIC_AUTH_URL=https://auth.example.com

# ПУБЛИЧНЫЙ адрес админ-панели платформы (iframe оболочки).
#   Форма: https://admin.<поддомен>.<домен>
#   (локально — http://admin.partner.fractera.local:3002)
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com

# Секрет подписи сессионных cookie. ПРИНАДЛЕЖИТ СЛУЖБЕ АВТОРИЗАЦИИ, не
# приложению: в коде приложения не читается ни разу, но живёт в общем файле
# окружения слота.
#   КАК ПОЛУЧИТЬ — СГЕНЕРИРОВАТЬ САМОМУ:
#     openssl rand -base64 32
#     (или https://generate-secret.vercel.app/32)
#   РОЛЬ: подделав его, посторонний выпишет себе любую сессию. Меняете —
#   разлогиниваются все.
AUTH_SECRET=

# Доверять заголовку Host при вычислении адреса возврата после входа.
#   За обратным прокси (а он тут всегда) — `true`. Иначе Auth.js строит ссылки
#   на localhost и вход зацикливается.
AUTH_TRUST_HOST=true

# РЕЖИМ «СЕРВЕР БЕЗ ДОМЕНА» — ОПАСНЫЙ ВЫКЛЮЧАТЕЛЬ, ЧИТАТЬ ЦЕЛИКОМ.
#   `true` = авторизация ОТКЛЮЧЕНА: любой запрос считается запросом архитектора
#   (`demo@local`, роль architect). Нужен ровно на одном отрезке жизни — когда
#   сервер поднят по IP, домена ещё нет, значит нет и cookie-домена для входа.
#   Читается: lib/auth/auth-bypass.ts — и читается ИЗ ФАЙЛА `.env.local`, а не из
#   памяти процесса: значение в памяти умеет расходиться с диском (панель
#   перезапускает соседей с --update-env), и однажды записанное `true` переживало
#   переключение в защищённый режим. Файл — правда, окружение — запасной путь.
#   КАК ТОЛЬКО ДОМЕН ПОЯВИЛСЯ — СТАВИТЬ `false`. Оставленный `true` на публичном
#   адресе означает: любой человек с выдуманной cookie `authjs.session-token`
#   получает права архитектора.
FRACTERA_IP_NODOMAIN_MODE=false

# Где лежит файл окружения, из которого читается флаг выше.
#   По умолчанию — `.env.local` в корне проекта. Задаётся только в нестандартной
#   раскладке каталогов (lib/auth/auth-bypass.ts:26).
# FRACTERA_ENV_FILE=/opt/fractera/app/.env.local

# Сторона, с которой выезжает ящик аккаунта: `left` | `right`.
#   РАНЬШЕ ЭТА ПЕРЕМЕННАЯ РЕШАЛА, ЕСТЬ ЛИ ВХОД ВООБЩЕ. Больше не решает
#   (components/menu/account/account-config.ts): включение авторизации живёт в
#   `PLATFORM-CONFIG/platform-config.json` → `features.auth`, сторона — в
#   `APP-CONFIG/app-config.json` → `nav.authSide`. Переменная осталась подсказкой
#   стороны на случай, когда владелец сторону не выбирал.
NEXT_PUBLIC_APP_SHELL_AUTH=right

# Прямой вход архитектора через /api/auth/architect?token=…
#   В коде приложения не читается (дверь принадлежит службе авторизации).
#   Заводить только осознанно: это постоянный ключ от всего.
# ARCHITECT_TOKEN=



# ══════════════════════════════════════════════════════════════════════════════
#  3. КЛЮЧИ ИНТЕГРАЦИЙ
#     Основное место ввода — ЭКРАН АДМИНИСТРАТОРА (Админка → Компания → Ключи).
#     Файл сильнее окружения; строки ниже — запасной путь для уже настроенных
#     серверов и для локальной разработки.
# ══════════════════════════════════════════════════════════════════════════════

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# ЧТО ЭТО: ключ доступа к моделям OpenAI. Строка вида `sk-proj-…` или `sk-…`.
# ГДЕ ВЗЯТЬ, ПОШАГОВО:
#   1. https://platform.openai.com/ → войти под аккаунтом организации;
#   2. слева «API keys» → «Create new secret key»;
#   3. дать имя (например `autozabota-prod`), выбрать проект;
#   4. скопировать СРАЗУ — второй раз OpenAI ключ не показывает;
#   5. проверить, что на счёте проекта есть баланс (Billing): ключ без денег
#      отвечает 429, и в интерфейсе это выглядит как «ИИ молчит».
# РОЛЬ В ПРОЕКТЕ:
#   • расшифровка голосового ввода (Whisper) — app/api/transcribe/route.ts,
#     _tools/voice-input/server/transcribe.ts;
#   • разбор входящих сообщений и составление ответов пациенту —
#     lib/products/telegram-desk/**;
#   • распознавание присланных фото и документов.
# ЧИТАЕТСЯ: lib/openai-key.ts — единственное место чтения на весь проект.
#   Порядок: экран администратора → окружение → строка из `.env.local` файлом.
# БЕЗ НЕГО: голосовой ввод и любые ответы модели отвечают «ключа нет»; остальное
#   приложение работает.
# ТРАТИТ ДЕНЬГИ. Утёкший ключ — это чужие счета на вашем балансе.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── YCLIENTS (CRM клиники) ───────────────────────────────────────────────────
# ЧТО ЭТО: доступ к CRM, где живёт правда о клиентах, визитах и услугах. У
# YCLIENTS авторизация ДВОЙНАЯ и в одном заголовке: партнёрский токен принадлежит
# приложению, пользовательский — сотруднику клиники. Один без другого не работает,
# и подсказки в ответе нет — приходит просто 401 (lib/care/yclients.ts).
#
# ГДЕ ВЗЯТЬ ПАРТНЁРСКИЙ ТОКЕН:
#   1. https://yclients.com/appstore/ → раздел для разработчиков, заявка на
#      партнёрский доступ (или через менеджера YCLIENTS вашей клиники);
#   2. после одобрения токен выдаётся в личном кабинете партнёра;
#   3. он один на приложение и не меняется при смене сотрудника.
# ГДЕ ВЗЯТЬ ПОЛЬЗОВАТЕЛЬСКИЙ ТОКЕН:
#   POST https://api.yclients.com/api/v1/auth
#   заголовки: Authorization: Bearer <партнёрский токен>
#              Accept: application/vnd.yclients.v2+json
#   тело: {"login":"<логин сотрудника>","password":"<пароль>"}
#   в ответе — поле `user_token`. Он привязан к учётной записи сотрудника: уволили
#   человека, отключили доступ — синхронизация встала.
# РОЛЬ: чтение клиентов, карточек с согласиями и записей филиала. ТОЛЬКО ЧТЕНИЕ —
#   ни один метод в CRM ничего не пишет.
# БЕЗ НИХ: синхронизация падает громко, с текстом ошибки. Это сделано намеренно:
#   молчаливое «нет ключей → пустой список» неотличимо от «в филиале нет клиентов».
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=

# Идентификатор ФИЛИАЛА, с которым работает это приложение. Одно приложение —
# одно учреждение.
#   ГДЕ ВЗЯТЬ: ① число в адресе кабинета YCLIENTS
#   (https://yclients.com/company/<ЭТО_ЧИСЛО>/…); ② либо запросом
#   GET /api/v1/companies с партнёрским + пользовательским токенами — в списке
#   вернутся все доступные филиалы с их `id`.
#   ЭТО ЕДИНСТВЕННЫЙ КЛЮЧ CRM, КОТОРЫЙ ЖИВЁТ ИМЕННО В ОКРУЖЕНИИ, а не на экране
#   администратора (lib/care/yclients.ts:41): филиал — это конфигурация установки,
#   а не сменный секрет.
#   БЕЗ НЕГО: «не задан YCLIENTS_SALON_ID — с каким филиалом работать, неизвестно».
YCLIENTS_SALON_ID=

# ─── ChatPush (отправка сообщений пациентам: WhatsApp / Telegram) ─────────────
# ЧТО ЭТО: единственная дверь продукта во внешний мир. Служба
# https://api.chatpush.ru держит сессии мессенджеров и отправляет текст на номер.
# ГДЕ ВЗЯТЬ ТОКЕН ОТПРАВКИ:
#   1. личный кабинет ChatPush (https://chatpush.ru) под учётной записью клиники;
#   2. раздел API / интеграции → токен доставки, формат Bearer;
#   3. там же поднимаются сами сессии WhatsApp/Telegram — токен без поднятой
#      сессии принимает сообщение и никуда его не отправляет.
# РОЛЬ: lib/care/chatpush.ts → sendText(). БЕЗ НЕГО сообщения копятся в базе со
#   статусом «не настроено» и наружу не уходят — это отдельный ответ, а не ошибка
#   сети, чтобы «отправлено» не врало.
CHATPUSH_TOKEN=

# Секрет ВХОДЯЩЕГО вебхука ChatPush — им служба доказывает, что стучится она.
#   ГДЕ ВЗЯТЬ: придумываете сами (`openssl rand -hex 32`) и вписываете ОДНО И ТО
#   ЖЕ значение в двух местах: сюда (или на экран ключей) и в настройки вебхука
#   в кабинете ChatPush.
#   ЧИТАЕТСЯ: app/api/care/chatpush/webhook/route.ts, app/api/care/tick/route.ts.
#   БЕЗ НЕГО: дверь для входящих закрыта, написанное пациентами теряется.
CHATPUSH_HOOK_SECRET=

# ─── Telegram Desk (служебный бот-стол) ───────────────────────────────────────
# Секрет входящего вебхука телеграм-стола. Проверяется как заголовок
# `x-channel-secret` (app/api/telegram/hook/route.ts:169, app/api/telegram/tick/route.ts).
#   ГДЕ ВЗЯТЬ: придумать самому (`openssl rand -hex 32`) и передать тем же
#   значением тому, кто настраивает вебхук.
#   БЕЗ НЕГО маршрут отвечает 503 «hook-not-configured» — то есть дверь закрыта
#   наглухо, а не открыта настежь. Это правильное поведение по умолчанию.
TELEGRAM_HOOK_SECRET=



# ══════════════════════════════════════════════════════════════════════════════
#  4. МОДЕЛИ ИИ (необязательно — у всех есть рабочие умолчания)
# ══════════════════════════════════════════════════════════════════════════════
#
#  Задавать имеет смысл, когда нужно поднять качество ответов или, наоборот,
#  срезать расходы. Пустое значение = умолчание из кода.

# Текстовая модель телеграм-стола: разбор намерения, ответ, исправления, расписание.
#   Умолчание: gpt-4o-mini (lib/products/telegram-desk/**).
# TGDESK_MODEL=gpt-4o-mini

# Модель для разбора КАРТИНОК и документов (vision).
#   Умолчание: gpt-4o-mini (lib/products/telegram-desk/branches/files.ts:98).
# TGDESK_VISION_MODEL=gpt-4o-mini

# Модель расшифровки речи.
#   Умолчание: whisper-1 (lib/products/telegram-desk/branches/files.ts:160).
# TRANSCRIBE_MODEL=whisper-1



# ══════════════════════════════════════════════════════════════════════════════
#  5. СОСЕДНИЕ СЛУЖБЫ ПЛАТФОРМЫ
#     Включаются переключателями на экране «Каналы»: включённый и неработающий
#     источник — обещание, которого продукт не сдержит.
# ══════════════════════════════════════════════════════════════════════════════

# Граф знаний LightRAG — векторная память по документам клиники.
#   Адрес: на сервере петля http://localhost:9621
#   (lib/company/channel-settings.ts:146).
#   ГДЕ ВЗЯТЬ: службу ставит установщик Fractera; порт фиксирован.
LIGHTRAG_URL=http://localhost:9621

# Ключ доступа к LightRAG.
#   ГДЕ ВЗЯТЬ: /opt/fractera/services/rag/.env на сервере (или выгрузка панели).
#   В коде приложения напрямую не читается — принадлежит службе; в файле слота
#   живёт, потому что окружение общее.
LIGHTRAG_API_KEY=

# Путь к файлу окружения службы RAG — служебная переменная платформы.
# RAG_ENV_PATH=/opt/fractera/services/rag/.env

# Служба карт и маршрутов.
#   Умолчание http://localhost:3400 (lib/company/channel-settings.ts:143).
# MAP_URL=http://localhost:3400

# Публичный адрес медиа-службы (картинки, файлы). NEXT_PUBLIC → в сборку.
#   Локально — http://localhost:3300, на бою — адрес медиа вашего слота.
NEXT_PUBLIC_MEDIA_URL=http://localhost:3300



# ══════════════════════════════════════════════════════════════════════════════
#  6. ЯЗЫКИ И ОБЛИК ПРИЛОЖЕНИЯ (всё build-time — правка требует пересборки)
# ══════════════════════════════════════════════════════════════════════════════

# Языки, которые сайт реально обслуживает. Через запятую, коды ISO 639-1.
#   ДВА И БОЛЬШЕ → появляется переключатель языка, контент живёт под /<lang>/… .
#   ОДИН → переключатель исчезает, страницы отдаются из корня без префикса.
#   Читается: config/translations/translations.config.ts, scripts/check-content.mjs.
#   Служебные страницы (/architecture, /ai-core, …) всегда остаются в корне.
NEXT_PUBLIC_SUPPORTED_LANGUAGES=ru,en

# Язык по умолчанию — на него уходит корень сайта и он подставляется, когда
# запрошенного перевода нет. В этом проекте — русский.
NEXT_PUBLIC_DEFAULT_LOCALE=ru

# ПОЛНЫЙ каталог возможных языков (82 кода) — СПРАВОЧНИК, а НЕ активный набор.
# Активный набор — строкой выше. Зеркалит ключи
# config/translations/language-metadata.ts.
# NEXT_PUBLIC_ALL_LANGUAGES=en,fr,es,pt,de,it,nl,sv,no,da,fi,is,el,pl,cs,sk,hu,ro,hr,sl,et,lv,lt,mt,ca,gl,cy,ga,eu,ru,uk,be,bg,sr,bs,mk,sq,kk,uz,ky,tg,tk,az,hy,ka,mn,ar,tr,he,fa,ku,af,sw,ha,yo,ig,am,zu,xh,rw,so,zh,ja,ko,hi,ur,bn,te,mr,kn,gu,ml,ta,ne,vi,th,id,ms,tl,my,km,lo

# Название и описание приложения: заголовок вкладки, метаданные, манифест.
#   Главный источник этих значений — APP-CONFIG/app-config.json, который правит
#   панель в рантайме. Переменные ниже — запасное значение на голой установке.
NEXT_PUBLIC_APP_TITLE=Автозабота
NEXT_PUBLIC_APP_DESCRIPTION=Забота о пациентах клиники на автопилоте
NEXT_PUBLIC_APP_VERSION=1.2.2

# Язык интерфейса оболочки и тема по умолчанию (`light` | `dark`).
#   Тема читается: components/theme-init.tsx, providers/theme-provider.client.tsx.
NEXT_PUBLIC_LANG=ru
NEXT_PUBLIC_DEFAULT_THEME=light

# Ссылки в подвале. Пустое значение = ссылка не рисуется.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_PRO_URL=
NEXT_PUBLIC_SKILLS_URL=



# ══════════════════════════════════════════════════════════════════════════════
#  7. РАЗВЁРТЫВАНИЕ И ЭКСПЛУАТАЦИЯ
#  ВЕСЬ ЭТОТ БЛОК — ДОСТУП К БОЕВОЙ МАШИНЕ. Ни одно значение отсюда не должно
#  оказаться в git, в скриншоте, в чате или в тикете.
# ══════════════════════════════════════════════════════════════════════════════

# Секрет, которым агент разработчика просит ПАНЕЛЬ собрать и выложить сборку.
#   ГДЕ ВЗЯТЬ: Админка → «Переменные окружения» → выгрузка окружения.
#   РОЛЬ: есть секрет — сборку ведёт панель (её очередь, её журнал развёртываний,
#   её откат на последнюю рабочую сборку). Нет — scripts/server/deploy.sh собирает
#   напрямую по SSH: быстрее, но журнал панели остаётся со старой записью, и
#   владелец видит в подвале чужую сборку.
#   Читается: scripts/server/deploy.sh:29.
FRACTERA_DEPLOY_SECRET=

# Доступ по SSH к серверу слота. Читается: scripts/server/run.sh (fx_need).
#   ГДЕ ВЗЯТЬ: всё, кроме приватного ключа, — в выгрузке окружения из панели.
#   Приватный ключ выдаёт владелец сервера; он уже авторизован на машине.
FRACTERA_SSH_HOST=203.0.113.10
FRACTERA_SSH_USER=root
FRACTERA_SSH_PORT=22

# Путь к приватному ключу на ВАШЕЙ машине. Относительный путь считается от корня
# проекта, `~` разворачивается. Скрипты сами ставят на файл права 600.
FRACTERA_SSH_KEY_PATH=.fractera-ssh/fractera-agent-key

# Тот же приватный ключ в base64 — из него файл выше разворачивается при первом
# запуске, чтобы не пересылать бинарник руками.
#   ЭТО ПОЛНОЦЕННЫЙ КЛЮЧ ОТ СЕРВЕРА В ОДНОЙ СТРОКЕ. Утёк — меняется ключ на
#   сервере, а не пароль.
FRACTERA_SSH_KEY_B64=

# Метка сборки: короткий хэш коммита и время сборки. Отдаются в /api/health и
# рисуются в подвале — по ним доказывают, что отвечает ИМЕННО ваша сборка.
#   РУКАМИ НЕ ЗАПОЛНЯЕТСЯ: значение пишет scripts/server/deploy.sh перед сборкой
#   (deploy.sh:59). Здесь — только чтобы имена были известны.
# NEXT_PUBLIC_GIT_COMMIT=
# NEXT_PUBLIC_BUILT_AT=

# Секрет ручного сброса кэша публичных страниц (POST /api/revalidate).
#   ГДЕ ВЗЯТЬ: придумать самому (`openssl rand -hex 32`).
#   Задан — требуется заголовок `Authorization: Bearer <значение>`. Не задан —
#   маршрут работает без него: он стоит за прокси-воротами API и только чистит
#   кэш, испортить данные не может.
# REVALIDATE_SECRET=

# Адрес приложения для служебных скриптов заливки медиа.
#   Умолчание http://127.0.0.1:3000 (scripts/seed-media.mjs:221).
# APP_ORIGIN=http://127.0.0.1:3000

# Репозиторий, откуда приложение тянет обновления архитектуры Fractera.
# UPSTREAM_REPO_URL=https://github.com/Fractera/fractera-light.git

# Куда указывает связка с GitHub-репозиторием владельца. Заполняет ПАНЕЛЬ при
# подключении репозитория; в коде приложения не читаются.
#   USER_GITHUB_ACCESS_TOKEN — персональный токен GitHub. В git не попадает
#   никогда; при подозрении на утечку отзывается на
#   https://github.com/settings/tokens.
# USER_GITHUB_REPO_URL=
# USER_GITHUB_ACCESS_TOKEN=

# Отметки времени, которые панель ставит себе на память: когда проверила связку
# с GitHub, когда владелец подтвердил набор языков, когда окружение было передано
# в слот. Формат ISO-8601. Ни код приложения, ни скрипты их не читают — руками не
# заполнять, они появляются сами.
# USER_GITHUB_VERIFIED_AT=
# USER_LANGUAGES_CONFIRMED_AT=
# USER_ENV_TRANSFERRED_AT=

# Служебная отметка дочернего процесса заливки медиа — руками не задаётся
# (scripts/seed-media-when-ready.mjs:45).
# FRACTERA_SEED_CHILD=



# ══════════════════════════════════════════════════════════════════════════════
#  8. ПУТИ К ФАЙЛАМ КОНФИГУРАЦИИ (задавать почти никогда не нужно)
# ══════════════════════════════════════════════════════════════════════════════
#
#  Живые настройки лежат в JSON-файлах и читаются на каждый запрос — поэтому
#  правка в панели действует сразу, без пересборки и перезапуска. Переменные ниже
#  переопределяют РАСПОЛОЖЕНИЕ этих файлов и нужны только при нестандартной
#  раскладке каталогов (например, конфиги на отдельном томе).

# APP_CONFIG_PATH=./APP-CONFIG/app-config.json                 # config/app-config.ts:19
# DESIGN_CONFIG_PATH=./DESIGN-CONFIG/design-config.json        # config/design-config.ts:21
# PLATFORM_CONFIG_PATH=./PLATFORM-CONFIG/platform-config.json  # config/platform-config.ts:53
# PRODUCTS_CONFIG_DIR=./PRODUCTS-CONFIG                        # config/products-config.ts:26
# LEGAL_CONFIG_DIR=./APP-CONFIG/legal                          # cookie-banner/banner-config.ts:18
# INTEGRATION_KEYS_PATH=./storage/integration-keys.json        # lib/company/keys.ts:26
# CHANNEL_SETTINGS_PATH=./storage/channel-settings.json        # lib/company/channel-settings.ts:10

# Предел контекста для хука агента разработки (`.claude/hooks/context-lib.mjs`).
# К работе приложения отношения не имеет — это настройка инструментов агента.
# CLAUDE_CONTEXT_LIMIT=



# ══════════════════════════════════════════════════════════════════════════════
#  9. БЕЗОПАСНОСТЬ — КОРОТКИЙ СПИСОК
# ══════════════════════════════════════════════════════════════════════════════
#
#  НАСТОЯЩИЕ СЕКРЕТЫ (утечка = чужой доступ или чужие счета):
#    DATA_SECRET / DATA_API_KEY · AUTH_SECRET · ARCHITECT_TOKEN · OPENAI_API_KEY ·
#    YCLIENTS_PARTNER_TOKEN · YCLIENTS_USER_TOKEN · CHATPUSH_TOKEN ·
#    CHATPUSH_HOOK_SECRET · TELEGRAM_HOOK_SECRET · LIGHTRAG_API_KEY ·
#    REVALIDATE_SECRET · FRACTERA_DEPLOY_SECRET · FRACTERA_SSH_KEY_B64 ·
#    USER_GITHUB_ACCESS_TOKEN
#
#  ПРАВИЛА:
#    ① Секрет никогда не носит префикс NEXT_PUBLIC_ — такая переменная уезжает
#       в браузер целиком.
#    ② `.env.local` перехвачен `.gitignore` (строки `.env`, `.env.local`,
#       `.env.*.local`). Проверить перед первым push:
#           git check-ignore -v .env.local
#    ③ Если секрет хоть раз попал в коммит — недостаточно удалить файл: история
#       остаётся. Ключ ПЕРЕВЫПУСКАЕТСЯ, а не прячется.
#    ④ Пять ключей интеграций правильнее вводить на экране администратора:
#       они действуют сразу и физически не лежат рядом с кодом.
# ==============================================================================
